{
  "name": "AgroPSRTheme",
  "dataColors": [
    "#1B4332",
    "#BC4749",
    "#D4A373",
    "#2D6A4F",
    "#52B788",
    "#457B9D",
    "#264653",
    "#E9C46A"
  ],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1B4332",
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 8
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1B4332"
              }
            },
            "fontSize": 11,
            "bold": true
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F5"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}